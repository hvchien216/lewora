{
	"name": "@lewora/source",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"// Development": "",
		"dev:nodeflow": "nx run @lewora/nodeflow:dev",
		"dev:mf-host": "nx run @lewora/mf-host:dev",
		"dev:mf-remote": "nx run @lewora/mf-remote:dev",
		"// Build": "",
		"build:all": "nx run-many --target=build --all",
		"build:nodeflow": "nx run @lewora/nodeflow:build",
		"build:mf-host": "nx run @lewora/mf-host:build",
		"build:mf-remote": "nx run @lewora/mf-remote:build",
		"// Clean": "",
		"clean": "nx run-many --target=clean && rm -rf node_modules .nx",
		"// Nx Utilities": "",
		"graph": "nx graph",
		"affected": "nx affected:graph",
		"affected:build": "nx affected --target=build",
		"affected:test": "nx affected --target=test",
		"// Linting": "",
		"lint:check": "biome check",
		"lint:fix": "biome check --write .",
		"// Versioning": "",
		"versions:check": "syncpack list-mismatches",
		"versions:fix": "syncpack fix-mismatches",
		"versions:format": "syncpack format"
	},
	"private": true,
	"devDependencies": {
		"@babel/core": "^7.14.5",
		"@babel/preset-react": "^7.14.5",
		"@biomejs/biome": "2.3.7",
		"@nx/jest": "22.0.2",
		"@nx/js": "22.0.2",
		"@nx/next": "22.0.2",
		"@nx/plugin": "22.0.2",
		"@nx/react": "22.0.2",
		"@nx/rsbuild": "22.0.2",
		"@nx/vite": "22.0.2",
		"@nx/web": "22.0.2",
		"@nx/workspace": "22.0.2",
		"@swc-node/register": "~1.9.1",
		"@swc/cli": "~0.6.0",
		"@swc/core": "~1.5.7",
		"@swc/helpers": "~0.5.11",
		"@testing-library/dom": "10.4.0",
		"@testing-library/react": "16.3.0",
		"@types/jest": "^30.0.0",
		"@types/node": "20.19.9",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.2.0",
		"@vitest/ui": "^3.0.0",
		"autoprefixer": "10.4.13",
		"babel-jest": "^30.0.2",
		"jest": "^30.0.2",
		"jest-environment-jsdom": "^30.0.2",
		"jest-util": "^30.0.2",
		"jiti": "2.4.2",
		"jsdom": "~22.1.0",
		"nx": "22.0.2",
		"syncpack": "^13.0.4",
		"ts-jest": "^29.4.0",
		"ts-node": "10.9.1",
		"tslib": "^2.3.0",
		"typescript": "~5.9.2",
		"vite": "^7.0.0",
		"vite-plugin-dts": "~4.5.0",
		"vitest": "^3.0.0"
	}
}
